{
  "name": "bazi-persona-skill",
  "version": "0.3.0",
  "description": "Awesome Bazi persona skill, generat AI person by Bazi Astrology",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "openclaw",
    "prompts",
    "SKILL.md",
    "README.md",
    "README.en.md",
    "README.ja.md",
    "README.ko.md",
    "README.zh-TW.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "bazi",
    "persona",
    "ai-skill",
    "claude-code",
    "openclaw",
    "hermes",
    "八字",
    "命理"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cantian-ai/bazi-persona-skill.git"
  },
  "homepage": "https://github.com/cantian-ai/bazi-persona-skill#readme",
  "bugs": {
    "url": "https://github.com/cantian-ai/bazi-persona-skill/issues"
  },
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "build:openclaw": "sh ./scripts/build-openclaw-release.sh",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "prepublishOnly": "npm run build",
    "bazi": "node dist/cli.js",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "cantian-tymext": "^0.0.26",
    "pinyin-pro": "^3.26.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
